{"archetype_id":"continuityworks:archetype/rural_gas_station","version":1,"family":"fuel_petroleum","facility_type":"retail_fuel","scale_tiers":["small","medium"],"purpose":"Roadside public fueling with a compact convenience building and clearly readable fueling forecourt.","required_modules":["continuityworks:module/fuel_canopy_13x5x9","continuityworks:module/pump_island_3x3x5","continuityworks:module/roadside_pylon_3x9x3","continuityworks:module/standard_room_9x5x9"],"optional_modules":["continuityworks:module/utility_service_9x5x9"],"allowed_corporate_languages":["continuityworks:corporate/northstar_fuel","continuityworks:corporate/frontier_cooperative"],"site_zones":[{"id":"road_frontage","role":"identity_and_entry"},{"id":"forecourt","role":"public_vehicle_service"},{"id":"store","role":"public_building"},{"id":"rear_service","role":"staff_and_delivery"}],"recognition":{"required_signatures":["fuel_canopy","pump_islands","storefront","roadside_pylon"],"supporting_signatures":["parking","rear_service","brand_band"],"minimum_required_fraction":1.0},"distinction":{"not_confusable_with":["continuityworks:archetype/bulk_tank_farm","continuityworks:archetype/crude_oil_well_pad"],"rules":["Customer-facing canopy and pump islands must dominate the roadside read.","The convenience building must present glazing/signage toward the forecourt.","Bulk storage or process towers may not dominate the public frontage."]},"circulation":{"public_vehicle":"pull_through_or_loop","pedestrian":"store_to_pumps","service":"rear_separated"},"vanilla_representation":{"block_policy":"vanilla_only","emphasis":"silhouette_and_zone_legibility"}}
