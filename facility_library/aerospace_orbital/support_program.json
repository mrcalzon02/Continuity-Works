{
  "program": "continuityworks:aerospace_support_infrastructure/v1",
  "status": "planned_for_phased_buildout",
  "purpose": "Build launch-support, vehicle-production, staging, refit, and transport facilities as actual vanilla materializable structures connected by explicit jigsaw-compatible road and infrastructure networks.",
  "inherits": {
    "aerospace_corpus": "docs/AEROSPACE_ORBITAL_CORPUS.md",
    "operator_languages": [
      "continuityworks:corporate/asterion_aerospace",
      "continuityworks:corporate/helium_orbital_works",
      "continuityworks:corporate/black_glass_launch_systems",
      "continuityworks:corporate/atlas_heavy_industries",
      "continuityworks:corporate/pel_roma_astronautics",
      "continuityworks:corporate/vcf_colonial_launch_authority"
    ],
    "scale_tiers": ["micro", "light", "standard", "heavy", "superheavy", "megastructure"],
    "minimum_distinct_support_facilities_per_scale": 2,
    "function_precedes_branding": true,
    "scale_changes_composition": true,
    "vanilla_reference_materialization": true
  },
  "hard_rules": {
    "support_facilities_are_network_bound": true,
    "minimum_site_graph_connections": 1,
    "launch_support_facilities_must_route_to_launch_anchor": true,
    "assembly_and_factory_facilities_require_inbound_and_outbound_logistics": true,
    "utility_dependent_facilities_require_utility_socket": true,
    "heavy_facilities_reject_undersized_road_profiles": true,
    "superheavy_facilities_require_superheavy_transport_or_explicit_exception": true,
    "different_seeds_or_operator_skins_do_not_count_as_distinct_archetypes": true,
    "references_are_minecraft_architectural_representations_not_engineering_specs": true
  },
  "support_design_modes": {
    "assembly_first": "Enclosed vehicle construction volume is the primary architectural read.",
    "transfer_first": "Movement of stages, components, or complete vehicles between anchors dominates the composition.",
    "fabrication_first": "Industrial production halls, material flow, and component output dominate.",
    "staging_first": "Storage, queueing, readiness, and organized holding areas dominate.",
    "refit_first": "Inspection, repair, recovery, and upgrade relationships dominate.",
    "factory_campus": "Multiple production halls, yards, utilities, and logistics spines operate as one manufacturing district.",
    "vehicle_spine": "A long heavy-transfer axis organizes multiple production, staging, and launch-support anchors.",
    "subterranean_support": "Surface support works connect to buried production, staging, or integration volumes.",
    "mixed_logistics": "Road, freight, personnel, utility, and vehicle-transfer systems are intentionally interwoven but remain type-safe."
  },
